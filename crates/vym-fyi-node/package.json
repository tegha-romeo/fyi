{
  "name": "@tegha-dze/fyi-node",
  "version": "0.1.15",
  "description": "Node.js bindings for FYI",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "vym-fyi-node",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --release --target x86_64-unknown-linux-gnu",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tegha-romeo/fyi.git#main"
  },
  "keywords": [
    "napi-rs",
    "node-addon",
    "rust"
  ],
  "author": "Tegha Romeo",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.5.0"
  },
  "dependencies": {
    "ansi-regex": "^6.2.2",
    "ansi-styles": "^6.2.3",
    "argparse": "^2.0.1",
    "before-after-hook": "^4.0.0",
    "chardet": "^2.1.1",
    "cli-width": "^4.1.0",
    "clipanion": "^4.0.0-rc.4",
    "colorette": "^2.0.20",
    "debug": "^4.4.3",
    "emnapi": "^1.7.1",
    "emoji-regex": "^10.6.0",
    "es-toolkit": "^1.43.0",
    "fast-content-type-parse": "^3.0.0",
    "get-east-asian-width": "^1.4.0",
    "iconv-lite": "^0.7.1",
    "js-yaml": "^4.1.1",
    "ms": "^2.1.3",
    "mute-stream": "^3.0.0",
    "obug": "^2.1.1",
    "safer-buffer": "^2.1.2",
    "semver": "^7.7.3",
    "signal-exit": "^4.1.0",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.1.2",
    "tslib": "^2.8.1",
    "typanion": "^3.14.0",
    "universal-user-agent": "^7.0.3",
    "wrap-ansi": "^9.0.2"
  },
  "bugs": {
    "url": "https://github.com/tegha-romeo/fyi/issues"
  },
  "homepage": "https://github.com/tegha-romeo/fyi/tree/main#readme"
}
