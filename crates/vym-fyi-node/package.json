{
  "name": "@tegha-dze/fyi-node",
  "version": "0.1.5",
  "description": "Node.js bindings for FYI",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "vym-fyi-node",
    "targets": [
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --release --target x86_64-unknown-linux-gnu",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tegha-romeo/fyi/tree/main/crates/vym-fyi-node"
  },
  "keywords": [
    "napi-rs",
    "node-addon",
    "rust"
  ],
  "author": "Tegha Romeo",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^3.5.0"
  }
}
